pipeline {

  agent { label 'infra-runner' }

  triggers {
    pollSCM('H/5 * * * *')
  }

  environment {
    AWS_DEFAULT_REGION = 'eu-west-2'
    TF_IN_AUTOMATION   = 'true'
  }

  stages {

    stage('Terraform Init & Validate') {
      steps {
        dir('terraform') {
          sh 'terraform init'
          sh 'terraform validate -no-color'
        }
      }
    }

    stage('Terraform Plan') {
      steps {
        withCredentials([
          usernamePassword(
            credentialsId: 'Amazon-AWS',
            usernameVariable: 'AWS_ACCESS_KEY_ID',
            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
          )
        ]) {
          dir('terraform') {
            sh 'terraform plan -out=tfplan -no-color'
          }
        }
      }
    }

    stage('Terraform Apply') {
      steps {
        withCredentials([
          usernamePassword(
            credentialsId: 'Amazon-AWS',
            usernameVariable: 'AWS_ACCESS_KEY_ID',
            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
          )
        ]) {
          dir('terraform') {
            sh 'terraform apply -auto-approve tfplan -no-color'
          }
        }
      }
    }
    stage('Ansible Deploy') {
      steps {
        withCredentials([
          file(credentialsId: 'id_rsa', variable: 'SERVER_KEY')
        ]) {
          sh '''
            cp "$SERVER_KEY" ~/.ssh/
            chmod 600 ~/.ssh/id_rsa
            ansible-playbook --private-key=~/.ssh/id_rsa main.yml
          '''
        }
      }
    }
    stage('Ansible Test') {
        steps {
          withCredentials([
            file(credentialsId: 'id_rsa', variable: 'SERVER_KEY')
          ]) {
            sh 'ansible-playbook --private-key=~/.ssh/id_rsa run_tests.yml'
          }
        }
    }
  }

  post {
    always {
      echo 'Tearing down'
        withCredentials([
          usernamePassword(
            credentialsId: 'Amazon-AWS',
            usernameVariable: 'AWS_ACCESS_KEY_ID',
            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
          )
        ]) {
          dir('terraform') {
            sh 'terraform destroy --auto-approve -no-color'
          }
        }

      echo 'Pipeline finished'
    }
    failure {
      echo 'Pipeline failed'
    }
    success {
      echo 'Pipeline succeeded'
    }
  }
}

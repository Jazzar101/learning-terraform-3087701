global:
  scrape_interval: 5s

scrape_configs:
  - job_name: "web_app"
    static_configs:
      - targets:
          - "{{ hostvars['app'].ansible_host }}:9100"
          - "{{ hostvars['app'].ansible_host }}:8080"
        labels:
          instance: "Web App"

  - job_name: "database"
    static_configs:
      - targets:
          - "{{ hostvars['database'].ansible_host }}:9100"
          - "{{ hostvars['database'].ansible_host }}:8080"
        labels:
          instance: "Database"

  - job_name: "monitoring"
    static_configs:
      - targets:
          - "{{ hostvars['monitoring'].ansible_host }}:9100"
          - "{{ hostvars['monitoring'].ansible_host }}:8080"
        labels:
          instance: "Monitoring"
